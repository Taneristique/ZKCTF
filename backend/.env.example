PORT=8787
PUBLIC_APP_URL=http://localhost:3001
SOLANA_RPC=https://api.devnet.solana.com
ZKCTF_PROGRAM_ID=34Kut3tQ4HTJMF2gVvnT6shhmenPE6463xnGk5sxDtz7

# Devnet Circle USDC (program USDC_MINT must match)
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# POT_USDC_ATA=
# TREASURY_USDC_ATA=
ENABLE_CHAIN_ENTER=1
ROUND_WINDOW=open

# AI drafts for weekly lessons (scripts/lesson.mjs) and race puzzles (weekly bot). Needs an sk-or- key.
# Empty key → blank templates / seed puzzles. A human always reviews before publish.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# Academy membership is paid in USDC on-chain (no card processor).
# Membership USDC goes to this wallet's USDC ATA (default: the authority wallet).
# TREASURY_WALLET=
# Founding member perk: first N seats, discount in basis points, early access to lessons.
# FOUNDING_SEATS=100
# FOUNDING_DISCOUNT_BPS=5000
# FOUNDING_EARLY_HOURS=24

# Program authority keypair (initialize / create_round / settle). Required for any real deploy:
# without it the backend falls back to a keypair derived from a public seed.
# AUTHORITY_KEYPAIR=/home/you/.config/solana/zkctf-devnet.json

# Optional override for JSON stores (entries, seats, solves, round…)
# ZKCTF_DATA_DIR=/var/lib/zkctf
